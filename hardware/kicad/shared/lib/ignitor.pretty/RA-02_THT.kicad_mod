(footprint "RA-02_THT"
	(version 20260206)
	(generator "ignitor")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "Ai-Thinker Ra-02 breakout adapter carrier (plug-in, THT): 2 rows x 8 pins, 2.54mm pitch, rows 25.4mm apart, board 33x24mm, matches the kevinta893 LoRa-Breakout-Board design. Clean 1:1 breakout of all 16 module pads: LEFT row top-to-bottom = pads 9,10,11,12,13,14,15,16 (GND,DIO4,DIO5,SCK,MISO,MOSI,NSS,GND); RIGHT row top-to-bottom = pads 8,7,6,5,4,3,2,1 (DIO3,DIO2,DIO1,DIO0,RESET,3.3V,GND,GND). Note: the original Fritzing part mislabels the pad-1 slot as ANT (off-by-one in its silkscreen); the ANT test point is not broken out on the adapter.")
	(tags "LoRa SX1278 Ai-Thinker Ra-02 breakout adapter THT carrier")
